<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dearlove.mapper.UserMapper">

  <resultMap id="UserResultMap" type="com.dearlove.model.User">
    <id property="username" column="username"/>
    <result property="passwordHash" column="password_hash"/>
    <result property="createdAt" column="created_at"/>
  </resultMap>

  <insert id="insert" parameterType="com.dearlove.model.User">
    INSERT INTO users (username, password_hash) VALUES (#{username}, #{passwordHash})
  </insert>

  <select id="findByUsername" resultMap="UserResultMap">
    SELECT username, password_hash, created_at FROM users WHERE username = #{username}
  </select>

</mapper>
